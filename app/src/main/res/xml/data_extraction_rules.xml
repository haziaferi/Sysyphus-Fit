<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §5, default until the owner decides: nothing goes to a cloud backup (the app has no
     network and its own one-file backup is the way out); a device-to-device transfer to a new phone
     carries everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
