<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 (minSdk 30), SPEC:R11: one rule set covers both cloud backup and device-to-device
     transfer. Every include requires the deviceToDeviceTransfer flag, so a transfer to a new phone
     carries everything and a cloud backup carries nothing, as data_extraction_rules.xml does. -->
<full-backup-content>
    <include domain="root" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="sharedpref" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="external" path="." requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
