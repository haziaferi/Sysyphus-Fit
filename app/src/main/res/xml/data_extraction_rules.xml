<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC:R11 (owner, 2026-11-21): nothing goes to a cloud backup (the app has no
     network and its own one-file backup is the way out); a device-to-device transfer to a new phone
     carries everything. Android 12 and later; Android 11 does the same through backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
